{
  "name": "@repo/db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "^0.31.7"
  },
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema.ts",
    "./queries": "./queries.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cd ../../apps/web && wrangler d1 migrations apply dac-investor-portal --local",
    "db:migrate:remote": "cd ../../apps/web && wrangler d1 migrations apply dac-investor-portal --remote",
    "db:push": "bun run scripts/with-local-d1.ts push",
    "db:studio": "bun run scripts/with-local-d1.ts studio",
    "db:setup:local": "bun run db:migrate:local"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7"
  }
}
